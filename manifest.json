{
  "manifest_version": 3,
  "name": "Video Download Grabber (local)",
  "version": "0.4.0",
  "description": "Detect playable video on the current tab and download it locally. No backend, no third-party calls.",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Video downloads"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/hook.ts"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "permissions": ["activeTab", "webRequest", "downloads", "storage", "scripting", "offscreen", "clipboardWrite"],
  "host_permissions": ["<all_urls>"]
}
