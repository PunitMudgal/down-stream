{
  "manifest_version": 3,
  "name": "Video Download Grabber (local)",
  "version": "1.1.1",
  "description": "Detect playable video on the current tab and download it locally. No backend, no third-party calls. YouTube is not supported.",
  "icons": {
    "16": "downstream.png",
    "32": "downstream.png",
    "48": "downstream.png",
    "128": "downstream.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Video downloads",
    "default_icon": {
      "16": "downstream.png",
      "32": "downstream.png",
      "48": "downstream.png",
      "128": "downstream.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtu.be/*",
        "*://youtube-nocookie.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["src/content.ts"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtu.be/*",
        "*://youtube-nocookie.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["src/hook.ts"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ],
  "permissions": ["activeTab", "webRequest", "webNavigation", "downloads", "storage", "scripting", "offscreen", "clipboardWrite", "contextMenus", "notifications"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "download-best-video": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Download the best video on this page"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      }
    }
  }
}
